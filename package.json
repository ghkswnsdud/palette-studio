{
  "name": "palette-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.app.json --noEmit --strict",
    "test": "node tests/run-all.mjs",
    "test:unit": "node tests/run-all.mjs --unit",
    "test:browser": "node tests/browser/run.mjs"
  },
  "dependencies": {
    "quantize": "^1.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/quantize": "^1.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
